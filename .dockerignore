# Never send secrets, dumps or local state into the image
.env*
!.env.example
backup-*.sql
*.dump
public/uploads/*

# Rebuilt inside Docker
node_modules
.next

# Not needed to run the app
.git
docs
e2e
test-results
playwright-report
coverage
*.md
# ...except the help articles the SkillFlow Assistant indexes (tools stage only).
!content/help/*.md
update.txt
