# .env.example — copy to .env and fill in real values, never commit .env itself

DATABASE_URL="postgresql://username:password@localhost:5432/dbname"

AUTH_SECRET="generate-with-npx-auth-secret"

AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
# ── Nearby ─────────────────────────────────────────────────────────────
# City search uses OpenStreetMap Nominatim. Its policy needs a real User-Agent with a way to reach you.
GEOCODER_USER_AGENT="SkillFlow/1.0 (you@example.com)"

# Fewest learners a city needs before the map shows it. Use 1 on your own machine. The default in code is 5.
MAP_MIN_LEARNERS=5

# Ticketmaster Discovery API key (https://developer.ticketmaster.com → My Apps → Consumer Key). Leave empty to switch the source off.
# The daily cap is 5,000 calls in code. It is not raised from here.
TICKETMASTER_API_KEY=""
# SerpApi key for Google Events (serpapi.com → Dashboard → Your Private API Key). Leave empty to switch it off.
SERPAPI_API_KEY=""
# Hard monthly cap on SerpApi searches. Keep it under your plan (the free plan has 250).
SERPAPI_MONTHLY_CAP=200
# Hours a cached (niche, city, source) answer stays fresh before a refresh.
EVENTS_TTL_HOURS=12
# How many (city, niche) pairs the cron refreshes, most-followed first.
EVENTS_CRON_PAIRS=20
# Bearer token for GET /api/cron/events. Generate one with: openssl rand -hex 32
CRON_SECRET="replace-with-a-long-random-string"

# Explain-back. Without a key the check does not pass a stage.
# Free key from https://aistudio.google.com/apikey — no card. This is the one the app uses.
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-flash-lite-latest"
# Paid alternative, or another OpenAI-compatible endpoint:
# OPENAI_API_KEY=""
# EXPLAIN_MODEL_URL="https://api.openai.com/v1/chat/completions"
# EXPLAIN_MODEL_KEY=""
# EXPLAIN_MODEL_NAME="gpt-4o-mini"

# ── Premium (Stripe) ───────────────────────────────────────────────────
# Leave these empty and /upgrade says Stripe is not configured. Nothing pretends a charge happened.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# The recurring price for the one Premium subscription (price_...).
STRIPE_PRICE_ID=""
# Signing secret for POST /api/stripe/webhook (whsec_...). Stripe CLI: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""
# Optional label shown if the price cannot be read from Stripe, e.g. "₹199 a month".
STRIPE_PRICE_LABEL=""

# ── Scripts only ───────────────────────────────────────────────────────
# scripts/fetch-stage-photos.ts searches Pexels as well as Openverse when this is set. The app never reads it.
# PEXELS_API_KEY=""


# Seed (run once on an empty database). Never commit real values.
SEED_ADMIN_EMAILS=you@example.com
SEED_ADMIN_PASSWORD=change-me-to-16-plus-characters
