// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// AUTH.JS REQUIRED MODELS
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]

  // App-specific
  currentStreak     Int       @default(0)
  longestStreak     Int       @default(0)
  lastActivityDate  DateTime?

  skillProgress     UserSkillProgress[]
  quizAttempts      QuizAttempt[]
  explainBackAttempts ExplainBackAttempt[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// SKILL TAXONOMY
// ─────────────────────────────────────────────

model Skill {
  id          String  @id @default(cuid())
  slug        String  @unique // e.g. "full-stack-web-dev"
  name        String
  description String?
  isFlagship  Boolean @default(false) // true for the 3 seeded launch niches
  order       Int     @default(0)

  stages         RoadmapStage[]
  userProgress   UserSkillProgress[]

  createdAt DateTime @default(now())
}

model RoadmapStage {
  id          String @id @default(cuid())
  skillId     String
  title       String
  description String?
  order       Int // sequence within the skill

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  resources          Resource[]
  quiz                Quiz?
  explainBackPrompt   ExplainBackPrompt?
  stageCompletions    StageCompletion[]

  @@unique([skillId, order])
}

// ─────────────────────────────────────────────
// RESOURCES (aggregation model — embed/link, never scrape)
// ─────────────────────────────────────────────

enum ResourceType {
  HOOK_CLIP        // short self-produced clip
  EMBEDDED_VIDEO   // third-party YouTube etc, embedded via official player
  DOC_LINK
  COURSE_LINK
}

model Resource {
  id      String       @id @default(cuid())
  stageId String
  type    ResourceType
  url     String
  order   Int

  // Snapshot metadata captured at ingestion time — used for graceful
  // degradation if the source URL ever goes dead/private, and as the
  // grounding context passed to the AI for quiz + explain-back generation.
  title       String
  description String?  @db.Text
  keyPoints   String?  @db.Text
  transcript  String?  @db.Text // for video; null for pure doc links

  stage RoadmapStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, order])
}

// ─────────────────────────────────────────────
// QUIZ ENGINE
// ─────────────────────────────────────────────

model Quiz {
  id      String @id @default(cuid())
  stageId String @unique
  version Int    @default(1) // increment when you re-tune prompts, for eval tracking

  stage     RoadmapStage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  createdAt DateTime @default(now())
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  prompt        String   @db.Text
  options       Json     // array of { id, text }
  correctOptionId String
  explanation   String   @db.Text // shown on miss, grounded in resource content
  order         Int

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  answers   Json     // array of { questionId, selectedOptionId, correct }
  score     Float    // 0.0–1.0
  passed    Boolean
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// SOCRATIC EXPLAIN-BACK GATE — the headline differentiator
// ─────────────────────────────────────────────

model ExplainBackPrompt {
  id      String @id @default(cuid())
  stageId String @unique
  version Int    @default(1)

  question String @db.Text // e.g. "Why does useEffect need a dependency array?"
  rubric   String @db.Text // grounded grading criteria, references stage resources

  stage RoadmapStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  attempts ExplainBackAttempt[]
}

enum ExplainBackVerdict {
  PASSED
  NEEDS_IMPROVEMENT
}

model ExplainBackAttempt {
  id       String @id @default(cuid())
  userId   String
  promptId String

  initialExplanation String @db.Text
  inputMethod        String // "text" | "voice"

  followUpQuestion String? @db.Text // AI-generated, targeted at the gap
  followUpResponse String? @db.Text

  verdict  ExplainBackVerdict
  feedback String             @db.Text // specific, not just pass/fail

  createdAt DateTime @default(now())

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt ExplainBackPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// PROGRESS & MASTERY TRACKING
// ─────────────────────────────────────────────

model UserSkillProgress {
  id            String  @id @default(cuid())
  userId        String
  skillId       String
  masteryPercent Float  @default(0)
  currentStageOrder Int @default(1)

  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model StageCompletion {
  id      String @id @default(cuid())
  userId  String
  stageId String

  quizPassed       Boolean @default(false)
  explainBackPassed Boolean @default(false)
  completedAt      DateTime?

  stage RoadmapStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([userId, stageId])
}