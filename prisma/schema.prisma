generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── AUTH.JS REQUIRED MODELS ──────────────────────

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  password      String?   // bcrypt hash; null for OAuth-only accounts
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]

  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime?

  skillProgress       UserSkillProgress[]
  quizAttempts        QuizAttempt[]
  explainBackAttempts ExplainBackAttempt[]

  submittedResources ResourceSubmission[] @relation("Submitter")
  reviewedResources  ResourceSubmission[] @relation("Reviewer")

  learnerProfile LearnerProfile?

  communityContributions CommunityContribution[] @relation("CommunityAuthor")
  mergedContributions    CommunityContribution[] @relation("CommunityMerger")
  contributionReviews    ContributionReview[]    @relation("CommunityReviewer")
  usefulMarks            UsefulMark[]
  contributionViews      ContributionView[]
  communityMemberships   CommunityMembership[]
  communityRoles         CommunityRole[]         @relation("CommunityMemberRole")
  grantedCommunityRoles  CommunityRole[]         @relation("CommunityRoleGranter")
  gapReports             GapReport[]
  creatorWorks           CreatorWork[] @relation("CreatorOwner")
  reviewedCreatorWorks   CreatorWork[] @relation("CreatorReviewer")
  creatorViews           CreatorView[] @relation("CreatorViewer")
}

model LearnerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  skillSlug String
  pace      String
  goal      String
  accent    String
  /// City name only. Never a street or a precise home location.
  city      String?
  country   String?
  /// City-centre coordinates, rounded to about a kilometre.
  lat       Float?
  lng       Float?
  showOnMap Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([showOnMap])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── SKILL TAXONOMY ──────────────────────

enum SkillStatus {
  AVAILABLE
  COMING_SOON
}

enum SkillOffer {
  FREE
  MONETIZED
}

enum NicheGroup {
  CARE
  MONEY
  HOME
  LANGUAGE
  GAMES
  CRAFT
  FUTURE
  MIND
}

enum StageLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Skill {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String?
  image       String
  status      SkillStatus @default(COMING_SOON)
  offer       SkillOffer  @default(MONETIZED)
  nicheGroup  NicheGroup  @default(MIND)
  isFlagship  Boolean     @default(false)
  order       Int         @default(0)

  stages       RoadmapStage[]
  userProgress UserSkillProgress[]

  communityContributions CommunityContribution[]
  communityMemberships   CommunityMembership[]
  communityRoles         CommunityRole[]
  gapReports             GapReport[]
  creatorWorks           CreatorWork[]

  createdAt DateTime @default(now())
}

model RoadmapStage {
  id                  String     @id @default(cuid())
  skillId             String
  title               String
  description         String?
  image               String?
  order               Int
  level               StageLevel @default(BEGINNER)
  learningObjectives  String[]   @default([])
  monetized           Boolean    @default(false)

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  resources         Resource[]
  submissions       ResourceSubmission[]
  quiz              Quiz?
  explainBackPrompt ExplainBackPrompt?
  stageCompletions  StageCompletion[]
  communityContributions CommunityContribution[]
  gapReports             GapReport[]

  @@unique([skillId, order])
}

// ── RESOURCES ──────────────────────

enum ResourceType {
  HOOK_CLIP
  EMBEDDED_VIDEO
  DOC_LINK
  COURSE_LINK
}

enum SourceStatus {
  ACTIVE
  UNAVAILABLE
}

model Resource {
  id      String       @id @default(cuid())
  stageId String
  type    ResourceType
  url     String
  order   Int

  title          String
  description    String?      @db.Text
  keyPoints      String[]     @default([])
  transcript     String?      @db.Text
  provider       String       @default("")
  author         String?
  videoId        String?
  isFree         Boolean      @default(true)
  language       String       @default("en")
  sourceStatus   SourceStatus @default(ACTIVE)
  lastVerifiedAt DateTime?
  needsReview    Boolean      @default(false)
  monetized      Boolean      @default(false)

  stage RoadmapStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, order])
  @@unique([stageId, url])
}

// ── USER-SUBMITTED CONTENT (moderated before publishing) ──────────────────────

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model ResourceSubmission {
  id      String       @id @default(cuid())
  stageId String
  type    ResourceType
  url     String
  title   String
  description String?  @db.Text

  status      SubmissionStatus @default(PENDING)
  reviewNotes String?          @db.Text
  reviewedAt  DateTime?

  submittedById String
  reviewedById  String?

  createdAt DateTime @default(now())

  stage       RoadmapStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  submittedBy User         @relation("Submitter", fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedBy  User?        @relation("Reviewer", fields: [reviewedById], references: [id])
}

// ── QUIZ ENGINE ──────────────────────

model Quiz {
  id      String @id @default(cuid())
  stageId String @unique
  version Int    @default(1)

  stage     RoadmapStage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  createdAt DateTime @default(now())
}

model QuizQuestion {
  id              String @id @default(cuid())
  quizId          String
  prompt          String @db.Text
  options         Json
  correctOptionId String
  explanation     String @db.Text
  order           Int

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  quizId    String
  answers   Json
  score     Float
  passed    Boolean
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

// ── SOCRATIC EXPLAIN-BACK GATE ──────────────────────

model ExplainBackPrompt {
  id      String @id @default(cuid())
  stageId String @unique
  version Int    @default(1)

  question String   @db.Text
  rubric   String[] @default([])

  stage    RoadmapStage         @relation(fields: [stageId], references: [id], onDelete: Cascade)
  attempts ExplainBackAttempt[]
}

enum ExplainBackVerdict {
  PASSED
  NEEDS_IMPROVEMENT
}

model ExplainBackAttempt {
  id       String @id @default(cuid())
  userId   String
  promptId String

  initialExplanation String @db.Text
  inputMethod        String

  followUpQuestion String? @db.Text
  followUpResponse String? @db.Text

  verdict  ExplainBackVerdict
  feedback String             @db.Text

  createdAt DateTime @default(now())

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt ExplainBackPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
}

// ── PROGRESS & MASTERY ──────────────────────

model UserSkillProgress {
  id                String @id @default(cuid())
  userId            String
  skillId           String
  masteryPercent    Float  @default(0)
  currentStageOrder Int    @default(1)

  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model StageCompletion {
  id      String @id @default(cuid())
  userId  String
  stageId String

  quizPassed        Boolean   @default(false)
  explainBackPassed Boolean   @default(false)
  completedAt       DateTime?

  stage RoadmapStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([userId, stageId])
}

// ── OPEN SOURCE COMMUNITY ──────────────────────
// Separate from Resource and ResourceSubmission. Nothing here is the official catalog.

enum ContributionType {
  RESOURCE
  CONCEPT_NOTE
  LEARNING_PATH
  FOLLOW
}

enum ContributionStatus {
  OPEN
  CHANGES_REQUESTED
  MERGED
  CLOSED
}

enum Disclosure {
  NONE
  I_MADE_THIS
  AFFILIATE_OR_SPONSORED
}

enum ReviewDecision {
  APPROVE
  REQUEST_CHANGES
  CLOSE
}

enum ReviewReason {
  OFF_TOPIC
  LOW_QUALITY
  DUPLICATE
  BROKEN_LINK
  UNDISCLOSED_PROMOTION
  INACCURATE
  OTHER
}

enum CommunityRoleType {
  REVIEWER
  MAINTAINER
}

enum GapStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum LinkCheckStatus {
  OK
  UNREACHABLE
  NOT_CHECKED
}

model CommunityContribution {
  id            String             @id @default(cuid())
  skillId       String
  authorId      String?
  type          ContributionType
  status        ContributionStatus @default(OPEN)
  title         String
  summary       String
  body          String?            @db.Text
  imageUrl      String?
  url           String?
  normalizedUrl String?
  sources       String[]           @default([])
  steps         Json?
  tags          String[]           @default([])
  stageId       String?
  disclosure    Disclosure
  gapId         String?
  linkStatus    LinkCheckStatus    @default(NOT_CHECKED)
  linkCheckedAt DateTime?
  usefulCount   Int                @default(0)
  viewCount     Int                @default(0)
  revision      Int                @default(1)
  mergedAt      DateTime?
  mergedById    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  skill       Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  author      User?          @relation("CommunityAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  stage       RoadmapStage?  @relation(fields: [stageId], references: [id], onDelete: SetNull)
  gap         GapReport?     @relation("GapCited", fields: [gapId], references: [id], onDelete: SetNull)
  mergedBy    User?          @relation("CommunityMerger", fields: [mergedById], references: [id], onDelete: SetNull)
  reviews     ContributionReview[]
  usefulMarks UsefulMark[]
  views       ContributionView[]
  resolvedGap GapReport?     @relation("GapResolvedBy")

  @@unique([skillId, normalizedUrl])
  @@index([skillId, status, mergedAt])
  @@index([skillId, status, usefulCount])
  @@index([authorId, createdAt])
  @@index([status, createdAt])
}

model ContributionReview {
  id             String         @id @default(cuid())
  contributionId String
  reviewerId     String?
  decision       ReviewDecision
  reason         ReviewReason?
  feedback       String?        @db.Text
  revision       Int
  /// A maintainer or admin hid a merged contribution. The decision is still CLOSE.
  unmerge        Boolean        @default(false)
  createdAt      DateTime       @default(now())

  contribution CommunityContribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  reviewer     User?                 @relation("CommunityReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([contributionId, createdAt])
  @@index([unmerge, createdAt])
}

model UsefulMark {
  userId         String
  contributionId String
  createdAt      DateTime @default(now())

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  contribution CommunityContribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@id([userId, contributionId])
}

model ContributionView {
  userId         String
  contributionId String
  createdAt      DateTime @default(now())

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  contribution CommunityContribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)

  @@id([userId, contributionId])
}

model CommunityMembership {
  userId     String
  skillId    String
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([skillId])
}

model CommunityRole {
  id          String            @id @default(cuid())
  userId      String
  skillId     String
  role        CommunityRoleType
  grantedById String?
  createdAt   DateTime          @default(now())

  user      User  @relation("CommunityMemberRole", fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("CommunityRoleGranter", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, skillId, role])
}

model GapReport {
  id                       String    @id @default(cuid())
  skillId                  String
  stageId                  String?
  authorId                 String?
  title                    String
  description              String    @db.Text
  status                   GapStatus @default(OPEN)
  goodFirst                Boolean   @default(false)
  resolvedByContributionId String?   @unique
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  skill      Skill                   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  stage      RoadmapStage?           @relation(fields: [stageId], references: [id], onDelete: SetNull)
  author     User?                   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  citations  CommunityContribution[] @relation("GapCited")
  resolvedBy CommunityContribution?  @relation("GapResolvedBy", fields: [resolvedByContributionId], references: [id], onDelete: SetNull)

  @@index([skillId, status, createdAt])
}

// ── CREATOR STUDIO ──────────────────────

enum CreatorWorkFormat {
  SHORT
  VIDEO
}

enum CreatorWorkStatus {
  DRAFT
  PENDING
  LIVE
  REJECTED
}

model CreatorWork {
  id              String            @id @default(cuid())
  ownerId         String
  skillId         String
  format          CreatorWorkFormat
  status          CreatorWorkStatus @default(DRAFT)
  title           String
  description     String?           @db.Text
  mediaUrl        String
  durationSec     Int               @default(0)
  rightsConfirmed Boolean           @default(false)
  reviewNotes     String?           @db.Text
  reviewedAt      DateTime?
  reviewedById    String?
  submittedAt     DateTime?
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  owner      User         @relation("CreatorOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  skill      Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  reviewedBy User?        @relation("CreatorReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  views      CreatorView[]

  @@index([ownerId, updatedAt])
  @@index([skillId, status])
}

model CreatorView {
  id         String   @id @default(cuid())
  workId     String
  viewerId   String?
  watchedSec Int      @default(0)
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  work   CreatorWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  viewer User?       @relation("CreatorViewer", fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([workId])
}